{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/psuvraneel-cyber/Clone-Proof/blob/main/docs/schemas/receipt-v1.schema.json",
  "title": "CloneProof Reproducibility Receipt v1",
  "description": "Evidence record describing one CloneProof run. It is not a security certification or a digital signature; the integrity digest detects modification only when the expected digest is trusted independently.",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptVersion", "receiptType", "generatedAt", "source", "tool", "execution", "environment", "result", "coverage", "integrity"],
  "properties": {
    "receiptVersion": { "const": 1 },
    "receiptType": { "const": "cloneproof.reproducibility" },
    "generatedAt": {
      "description": "UTC timestamp with millisecond precision (ISO 8601).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "url", "commit", "ref", "subdirectory", "revisionIdentity", "identitySource"],
      "properties": {
        "kind": { "enum": ["local", "github"] },
        "repository": { "anyOf": [{ "$ref": "#/$defs/repository" }, { "type": "null" }] },
        "url": {
          "anyOf": [
            { "type": "string", "maxLength": 160, "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]{1,100}$" },
            { "type": "null" }
          ]
        },
        "commit": { "anyOf": [{ "$ref": "#/$defs/fullCommitSha" }, { "type": "null" }] },
        "ref": { "anyOf": [{ "$ref": "#/$defs/gitRef" }, { "type": "null" }] },
        "subdirectory": {
          "description": "Target folder relative to the Git checkout root, when the checkout root was found.",
          "anyOf": [
            { "type": "string", "maxLength": 512, "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))(?:\\.|[A-Za-z0-9._@+ -]+(?:/[A-Za-z0-9._@+ -]+)*)$" },
            { "const": "." },
            { "type": "null" }
          ]
        },
        "revisionIdentity": { "enum": ["commit", "unavailable"] },
        "identitySource": { "enum": ["local-git-metadata", "cloneproof-github-clone", "none"] }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "receiptGeneratorVersion", "reportSchemaVersion", "action"],
      "properties": {
        "name": { "const": "cloneproof" },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "receiptGeneratorVersion": { "const": 1 },
        "reportSchemaVersion": { "const": 2 },
        "action": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "ref"],
              "properties": {
                "repository": { "anyOf": [{ "$ref": "#/$defs/repository" }, { "type": "null" }] },
                "ref": { "anyOf": [{ "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9._/-]{1,128}$" }, { "type": "null" }] }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation", "mode", "verificationRequested", "verificationAuthorized", "repositoryCommandsExecuted", "repositoryCommandsEnvironment", "container"],
      "properties": {
        "invocation": { "enum": ["cli", "github-action"] },
        "mode": { "enum": ["check", "verify"] },
        "verificationRequested": { "type": "boolean" },
        "verificationAuthorized": { "type": "boolean" },
        "repositoryCommandsExecuted": { "type": "boolean" },
        "repositoryCommandsEnvironment": { "enum": ["none", "controlled-docker"] },
        "container": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["image", "imageDigest", "networkPolicy", "timeoutMs"],
              "properties": {
                "image": { "anyOf": [{ "type": "string", "maxLength": 300, "pattern": "^[a-z0-9][a-z0-9._/:-]{0,230}(?:@sha256:[0-9a-f]{64})?$" }, { "type": "null" }] },
                "imageDigest": { "anyOf": [{ "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, { "type": "null" }] },
                "networkPolicy": { "enum": ["none", "bridge", null] },
                "timeoutMs": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 86400000 }, { "type": "null" }] }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "os", "arch", "nodeVersion", "github"],
      "properties": {
        "runner": { "enum": ["local", "github-hosted", "self-hosted", "github-actions"] },
        "os": { "enum": ["aix", "android", "cygwin", "darwin", "freebsd", "haiku", "linux", "netbsd", "openbsd", "sunos", "win32"] },
        "arch": { "enum": ["arm", "arm64", "ia32", "loong64", "mips", "mipsel", "ppc", "ppc64", "riscv64", "s390", "s390x", "x64"] },
        "nodeVersion": { "type": "string", "maxLength": 32, "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "github": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "workflow", "runId", "runAttempt", "eventName", "ref", "workflowCommit", "runnerOs"],
              "properties": {
                "repository": { "anyOf": [{ "$ref": "#/$defs/repository" }, { "type": "null" }] },
                "workflow": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" }, { "type": "null" }] },
                "runId": { "anyOf": [{ "type": "string", "pattern": "^[0-9]{1,20}$" }, { "type": "null" }] },
                "runAttempt": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 1000 }, { "type": "null" }] },
                "eventName": { "anyOf": [{ "type": "string", "pattern": "^[a-z_]{1,64}$" }, { "type": "null" }] },
                "ref": { "anyOf": [{ "$ref": "#/$defs/gitRef" }, { "type": "null" }] },
                "workflowCommit": { "anyOf": [{ "$ref": "#/$defs/fullCommitSha" }, { "type": "null" }] },
                "runnerOs": { "enum": ["Linux", "Windows", "macOS", null] }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verificationOutcome", "summary", "findings", "cleanup"],
      "properties": {
        "status": { "enum": ["passed", "passed_with_warnings", "failed", "blocked", "incomplete"] },
        "verificationOutcome": { "enum": ["not_run", "passed", "failed", "blocked", "error"] },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "warnings", "skipped"],
          "properties": {
            "total": { "$ref": "#/$defs/count" },
            "passed": { "$ref": "#/$defs/count" },
            "failed": { "$ref": "#/$defs/count" },
            "warnings": { "$ref": "#/$defs/count" },
            "skipped": { "$ref": "#/$defs/count" }
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "status"],
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
              "status": { "enum": ["passed", "failed", "warning", "skipped"] }
            }
          }
        },
        "cleanup": { "enum": ["confirmed", "failed", "incomplete", "not_applicable"] }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "notChecked"],
      "properties": {
        "checked": { "$ref": "#/$defs/coverageIds" },
        "notChecked": { "$ref": "#/$defs/coverageIds" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "cloneproof-canonical-json-v1" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "$defs": {
    "fullCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repository": { "type": "string", "maxLength": 140, "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]{1,100}$" },
    "gitRef": { "type": "string", "maxLength": 255, "pattern": "^(?!.*\\.\\.)(?!.*//)(?!.*/$)refs/(?:heads|tags|remotes|pull)/[A-Za-z0-9._/+-]{1,240}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "coverageIds": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }
    }
  }
}
