{
  "name": "cloneproof",
  "version": "0.2.0",
  "description": "Evidence-based setup verification for Node.js repositories.",
  "keywords": [
    "nodejs",
    "npm",
    "reproducibility",
    "onboarding",
    "setup",
    "static-analysis",
    "docker",
    "github-action",
    "cli"
  ],
  "homepage": "https://github.com/psuvraneel-cyber/Clone-Proof#readme",
  "bugs": {
    "url": "https://github.com/psuvraneel-cyber/Clone-Proof/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psuvraneel-cyber/Clone-Proof.git"
  },
  "type": "commonjs",
  "main": "src/cli.js",
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "cloneproof": "src/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node src/cli.js check",
    "start": "node src/cli.js check .",
    "test": "npm run build && node --test",
    "test:leaks": "npm run build && node scripts/check-temp-leaks.js",
    "verify": "node src/cli.js verify"
  },
  "license": "MIT"
}
